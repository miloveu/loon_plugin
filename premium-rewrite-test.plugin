#!name=会员重写测试
#!desc=Loon 重写演示题：把抓包数据（HAR 中 GET /auth/me 的响应体，解码自 btcapi.meihuagold.com）替换到 WorkBuddy 演示站点 loon-rewrite-demo.app.workbuddy.host 的 /auth/me 响应上，并把 Premium 到期时间改写为 2099-09-09，兼容页面「JSON 明文 / Base64 编码」两种格式。导入插件 → 开启 MITM 并信任证书 → 完全关闭 Safari 再打开演示页，即显示绿色「会员有效」。
#!icon=https://loon-rewrite-demo.app.workbuddy.host/favicon.ico
#!author=miloveu
#!date=2026-11-23
#!tag=演示
# ============================================================
# 安装说明
# 1) 数据来源：抓包文件 643_1795359842680.har（Loon 抓包）中
#    GET https://btcapi.meihuagold.com/auth/me 的响应体（Base64 → JSON）。
# 2) 需安装并信任 Loon CA 证书（http-response 脚本依赖 HTTPS 解密）。
# 3) 演示页地址：https://loon-rewrite-demo.app.workbuddy.host/?sharecode=3RHY43Q2B7
# 4) 改动后完全杀死 Loon 与 Safari 再重开；想还原：在 Loon 里关掉本插件。
# ============================================================

[Script]
# http-response 改写：拦截演示站 /auth/me 的响应，由 premium-rewrite.js 完成替换
# 地址带 ?v=1 版本参数，用于强制 Loon 刷新脚本缓存（更新脚本时递增）
http-response ^https?:\/\/loon-rewrite-demo\.app\.workbuddy\.host\/auth\/me script-path=https://raw.githubusercontent.com/miloveu/loon_plugin/main/premium-rewrite.js?v=1, requires-body=true, timeout=60, tag=会员重写测试

[MITM]
# 仅解密演示站这一个域名，不影响其他流量
hostname = loon-rewrite-demo.app.workbuddy.host
