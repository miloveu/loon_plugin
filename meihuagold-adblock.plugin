#!name=黄金形态通去广告 v2
#!desc=屏蔽黄金形态通(meihuagold.com)内的自营推广 banner。v1 真机验证：REJECT-DICT 返回 {} 后 App 不隐藏 banner，而是沿用本地缓存的旧广告配置+已缓存图片渲染（7 次 ad.json 全部返回 {}，banner 仍在，且无任何广告图/落地页请求）。v2 改用脚本把 ad.json 响应伪造为合法配置 {"link":{"display":"no"}}，让 App 以「服务端关闭广告」覆盖缓存。第三方埋点(shujupie/alibaba aplus)与第一方统计拦截不变。行情接口与极验验证码全部放行。
#!icon=https://img.apuse3c.com/source/www/template/fav.ico
#!author=miloveu
#!date=2026-11-19
#!tag=去广告

# ============================================================
# 安装说明
# 1) 需安装并信任 Loon CA 证书（脚本与 URL-REGEX 均依赖 HTTPS 解密）。
# 2) 建议开启 Loon → 配置 → MitM →「QUIC 回退保护」。
# 3) ★ v2 关键步骤：更新插件后必须清一次 App 缓存（App 设置内「清除缓存」，
#    或完整删除 App 重装），否则已缓存的 banner 图会继续显示（缓存续命）。
# 4) 改动后完全杀死 Loon 与 App 再重开。
# ============================================================

[Rule]

# ── 广告素材图 / 落地页兜底拦截 ──────────────────────────────
# /ad/ 路径下的广告图（如 /ad/5-20.jpg）与未来新增广告素材，统一拦截
URL-REGEX,^https?:\/\/www\.meihuagold\.com\/ad\/,REJECT

# ── 第三方埋点 / 统计（v1 已真机验证可安全拦截）──────────────
# umini.shujupie.com —— 数聚派 U-Mini 前端埋点 SDK，纯数据上报，整域拦截
DOMAIN-SUFFIX,shujupie.com,REJECT
# d.alicdn.com/alilog —— 阿里 aplus 前端统计脚本（共享 CDN，仅拦统计路径）
URL-REGEX,^https?:\/\/d\.alicdn\.com\/alilog,REJECT
# appanalytics.meihuagold.com —— App 自有统计上报域（/v1/ping）
DOMAIN,appanalytics.meihuagold.com,REJECT

# ── 明确放行（勿拦截，列于此作提醒）─────────────────────────
# api.meihuagold.com / goldapi.meihuagold.com / goldhub.meihuagold.com —— 行情与数据
# api.geetest.com / static.geetest.com —— 极验验证码，拦了会导致登录/校验失败
# www.meihuagold.com/run/flash.json —— 快讯内容，非广告
# www.todayusstock.com —— 美股市场日历数据

[Script]
# 广告配置伪造：把 ad.json 响应体替换为 {"link":{"url":"","display":"no","image":null}}
# 原理：v1 返回 {} 时 App 视为「解析不到有效配置」→ 沿用本地缓存继续渲染。
# v2 返回一份合法但 display=no 的配置，App 会将其作为服务端最新配置覆盖缓存。
# 若真机验证 display=no 不被识别，可尝试把 body 改为 null 或空串（见下方备选注释）。
http-response ^https?:\/\/www\.meihuagold\.com\/ad\/ad\.json script-path=javascript:$done({body:JSON.stringify({link:{url:"",display:"no",image:null}})}), requires-body=true, tag=广告配置关闭

# 备选（若 display=no 无效，逐个换试，改完务必清缓存重开）：
# http-response ^https?:\/\/www\.meihuagold\.com\/ad\/ad\.json script-path=javascript:$done({body:"null"}), requires-body=true, tag=广告配置关闭
# http-response ^https?:\/\/www\.meihuagold\.com\/ad\/ad\.json script-path=javascript:$done({body:""}), requires-body=true, tag=广告配置关闭

[MITM]
# 仅解密按 URL 路径匹配 / 脚本所需的最小域名集：
#   www.meihuagold.com —— ad.json 脚本改写与 /ad/ 图片拦截依赖
#     （同域 /run/flash.json 等业务请求只解密不修改，无功能影响）
#   d.alicdn.com —— /alilog 统计路径规则依赖（若解密后静态资源异常，
#     删除本域回退即可，仅影响该统计脚本放行）
hostname=www.meihuagold.com,d.alicdn.com
