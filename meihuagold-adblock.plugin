#!name=黄金形态通去广告 v1
#!desc=屏蔽黄金形态通(meihuagold.com)内的自营推广 banner（ad/ad.json + 广告图）、数聚派 shujupie 第三方埋点、阿里 aplus 统计脚本与第一方 appanalytics 上报。行情接口(api/goldapi/goldhub.meihuagold.com)与极验 geetest 验证码全部放行，不影响任何行情功能。规则基于 2026-11-19 真机 HAR 抓包（74 条请求）核实。
#!icon=https://img.apuse3c.com/source/www/template/fav.ico
#!author=miloveu
#!date=2026-11-19
#!tag=去广告

# ============================================================
# 安装说明
# 1) URL-REGEX 规则需要解密 HTTPS 才能匹配 URL 路径：
#    需先安装并信任 Loon CA 证书（Loon → 设置 → 证书管理），
#    且 [MITM] hostname 中的域名保持开启 HTTPS 解密。
# 2) 若 Ad 域为 HTTP/3 (QUIC) 流量导致拦截不生效：
#    Loon → 配置 → MitM → 开启「QUIC 回退保护」。
# 3) 改动后完全杀死 Loon 与 App 再重开。
# ============================================================

[Rule]

# ── 自营推广 banner（本次抓包确认的广告本体）─────────────────
# www.meihuagold.com/ad/ad.json（抓包命中 2 次）
#   响应体为 JSON 对象 {"link":{"url":"https://lp.lqbnhy.com/cn/zt/...","display":"yes",
#   "image":{"src":".../ad/5-20.jpg"}}} —— App 的推广 banner 配置源。
#   ★ 顶层是对象，按类型选型用 REJECT-DICT（返回 200 + {}）：
#     404 会让 App 沿用本地缓存的旧广告配置（参考 investing-cn 插件 v9 教训），
#     空对象才是让 App 以「无广告」覆盖缓存的正确空态。
#   若你的 Loon 版本不识别 REJECT-DICT（表现为广告仍在），把下面这条改成
#   REJECT 并清一次 App 数据/缓存后再观察。
URL-REGEX,^https?:\/\/www\.meihuagold\.com\/ad\/ad\.json,REJECT-DICT
# /ad/ 路径下的广告素材图（如 /ad/5-20.jpg）与未来新增广告图，统一拦截
URL-REGEX,^https?:\/\/www\.meihuagold\.com\/ad\/,REJECT

# ── 第三方埋点 / 统计 ────────────────────────────────────────
# umini.shujupie.com（抓包命中 13 次：/web_logs POST 上报 ×6 + OPTIONS 预检 ×6 + /eg.js 配置）
#   数聚派 U-Mini 前端埋点 SDK，纯数据上报用途，整域可安全 REJECT。
DOMAIN-SUFFIX,shujupie.com,REJECT
# d.alicdn.com/alilog/mlog/aplus/203467608.js（抓包命中 1 次）
#   阿里 aplus 前端统计脚本。d.alicdn.com 是共享静态 CDN，
#   只拦 /alilog 统计路径，不整域拦截，避免误伤其他静态资源。
URL-REGEX,^https?:\/\/d\.alicdn\.com\/alilog,REJECT

# ── 第一方统计 ───────────────────────────────────────────────
# appanalytics.meihuagold.com（抓包命中 2 次：/v1/ping）
#   App 自有统计上报域，与行情数据无关，整域可安全 REJECT。
DOMAIN,appanalytics.meihuagold.com,REJECT

# ── 明确放行（勿拦截，列于此作提醒）─────────────────────────
# api.meihuagold.com / goldapi.meihuagold.com / goldhub.meihuagold.com —— 行情与数据
# api.geetest.com / static.geetest.com —— 极验验证码，拦了会导致登录/校验失败
# www.meihuagold.com/run/flash.json —— 快讯内容，非广告
# www.todayusstock.com —— 美股市场日历数据

[MITM]
# 仅解密按 URL 路径匹配所需的最小域名集：
#   www.meihuagold.com —— ad/ad.json 与 /ad/ 广告图路径规则依赖（同域的
#     /run/flash.json 等业务请求只解密不改写，无功能影响）
#   d.alicdn.com —— /alilog 统计路径规则依赖（共享 CDN，一般无证书固定；
#     若解密后出现静态资源异常，删除本域并接受该统计脚本放行即可回退）
hostname=www.meihuagold.com,d.alicdn.com
