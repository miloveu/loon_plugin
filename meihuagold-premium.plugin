#!name=比特形态通会员
#!desc=基于抓包数据（643/650.har）的 Loon 插件：改写 btcapi.meihuagold.com 的 /auth/(me|apple) 会员状态为 2099-09-09，并放行 PUT /push-prefs 的 Premium 403 拦截。需与 meihuagold-premium.js 一起部署。
#!icon=https://img.apuse3c.com/source/www/template/fav.ico
#!author=miloveu
#!date=2026-11-23
#!tag=演示
#
# 使用：安装并信任 Loon CA 证书，开启 MITM；改动后杀死 Loon 与 App 再重开。
# 结论：会员数据由服务端下发，本地改包只影响界面显示，不改变服务端记录。

[Script]
# 覆盖三个接口：
#   /auth/me    —— 读取会员状态（改 premiumExpiresAt / premiumFeatureEnabled / pushPrefs）
#   /auth/apple —— 登录响应（App 会缓存其中的 user 对象，需一并改写）
#   /push-prefs —— 两类都要处理：策略写操作的 Premium 403 伪造成
#                 200 {"ok":true,"pushPrefs":{...}}（缺键会报「数据丢失」）；
#                 真实 200（如只改 timeframe 不需 Premium）里的开关是服务端
#                 真实状态 false，原样放行会把界面开关弹回。
#                 开关状态由脚本用 $persistentStore 记录用户每次 PUT 的意图，
#                 响应按本地状态回写——开哪个才开哪个，关了就是关了
http-response ^https?:\/\/btcapi\.meihuagold\.com\/(auth\/(me|apple)|push-prefs) script-path=https://raw.githubusercontent.com/miloveu/loon_plugin/main/meihuagold-premium.js?v=13, requires-body=true, timeout=60, tag=会员状态改写

[MITM]
hostname = btcapi.meihuagold.com
