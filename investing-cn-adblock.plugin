#!name = 英为财情去广告
#!desc = 屏蔽英为财情(Investing.com) iOS App 内的 Google AdMob 广告、Index Exchange 竞价、Facebook 事件上报及 App 内促销横幅。纯 REJECT 规则，无需 MITM。
#!icon = https://static.investing.com/core/images/investing-logo.png
#!author = WorkBuddy
#!date = 2026-11-16
#!tag = 去广告

[General]

# --------------------------------------------------
# [Rule] 广告与追踪拦截
# --------------------------------------------------
[Rule]

# ---- Google AdMob / DoubleClick 广告素材与组件 ----
DOMAIN-SUFFIX,2mdn.net,REJECT
DOMAIN-SUFFIX,googletagservices.com,REJECT
DOMAIN-SUFFIX,adtrafficquality.google,REJECT
# AdMob 广告投放主域（插屏/横幅广告的投放请求走这里，2mdn 只是素材 CDN）
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
# Google 统计/埋点
DOMAIN-SUFFIX,google-analytics.com,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,analytics.google.com,REJECT
URL-REGEX,^https?:\/\/static\.googleadsserving\.cn,REJECT
# gstatic.cn 只拦广告 SDK 用的 /mysidia/ 路径，不影响其他 Google 中国资源
URL-REGEX,^https?:\/\/www\.gstatic\.cn\/mysidia,REJECT

# ---- Index Exchange / Casale 竞价与广告事件上报 ----
DOMAIN-SUFFIX,casalemedia.com,REJECT
DOMAIN-SUFFIX,indexww.com,REJECT
DOMAIN,event,REJECT

# ---- 广告 SDK 配置 ----
DOMAIN-SUFFIX,app-ads-services.com,REJECT

# !!! 保守版已移除以下三条（曾导致 App 启动卡住），如需再加回请逐条测试：
# DOMAIN-SUFFIX,ep2.facebook.com,REJECT
# DOMAIN-SUFFIX,onetrust.io,REJECT
# DOMAIN-SUFFIX,firebaseremoteconfig.googleapis.com,REJECT

# ---- App 自带的运营促销横幅（Markets / Watchlist 页，拦截后可能留白） ----
URL-REGEX,^https?:\/\/endpoints\.investing\.com\/content-mobile\/v2\/banner,REJECT
URL-REGEX,^https?:\/\/storage\.googleapis\.com\/content-mobile-static-resources\/banner,REJECT

# ---- 自营推广 WebView（"更多"菜单页促销横幅等，第二次抓包定位） ----
DOMAIN-SUFFIX,mobile-web-promo.investing.com,REJECT

[Script]

[MITM]
hostname =
