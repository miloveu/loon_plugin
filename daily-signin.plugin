#!name = 论坛每日登录领积分（网吧三国 + 死性不改BBS）
#!desc = Safari 登录论坛时自动抓取 Cookie；每天定时用 Cookie 登录论坛、领取每日任务（天天打卡）奖励并通知。Cookie 失效会提醒重新登录。一份脚本双入口：http-request 抓 Cookie，cron 每日签到。
#!author = WorkBuddy
#!openUrl = https://www.clxp.net.cn/

# ─────────────────────────────────────────────
# 已按仓库 miloveu/loon_plugin (main 分支) 填好脚本地址。
# 使用步骤：
# 1. 把本插件文件和 forum-signin.js 一起上传到该仓库根目录
# 2. Loon 开启 → Safari 登录两个论坛各一次（抓 Cookie）
# ─────────────────────────────────────────────

[Script]
# Cookie 抓取：两个论坛通用，登录/浏览时自动保存登录态（forum-signin.js 的 http-request 身份）
cookie-capture = type=http-request, pattern=^https?://(www\.)?(583go\.com|clxp\.net\.cn)/, script-path=https://raw.githubusercontent.com/miloveu/loon_plugin/main/forum-signin.js, requires-body=false, timeout=10, enabled=true

# 每日定时登录（每天 09:20 执行，可自行修改 cron 表达式）（forum-signin.js 的 cron 身份）
daily-checkin = type=cron, cron="20 9 * * *", script-path=https://raw.githubusercontent.com/miloveu/loon_plugin/main/forum-signin.js, timeout=120, enabled=true

# MITM：两个站都要解密（Safari 会把 583go 的 http 自动升级为 https）
# 前提：Loon → 配置 → 证书 已生成并安装，且 iOS 设置里已信任该证书
[MITM]
hostname = www.583go.com, www.clxp.net.cn, 583go.com, clxp.net.cn
