#!name = 论坛每日登录领积分（网吧三国 + 死性不改BBS）
#!desc = Safari 登录论坛时自动抓取 Cookie；每天定时用 Cookie 登录论坛、领取每日任务（天天打卡）奖励并通知。Cookie 失效会提醒重新登录。一份脚本双入口：http-request 抓 Cookie，cron 每日签到。
#!author = WorkBuddy
#!openUrl = https://www.clxp.net.cn/

# ─────────────────────────────────────────────
# 使用前请完成两步：
# 1. 把本插件和 forum-signin.js 上传到 GitHub/Gitee 等
#    获得 raw 直链，并把下方两处 REPLACE-WITH-YOUR-HOST
#    替换成你的 raw 目录地址（保持 /forum-signin.js 后缀不变）
# 2. 安装插件后：Loon 开启 → Safari 登录两个论坛各一次（抓 Cookie）
# ─────────────────────────────────────────────

[Script]
# Cookie 抓取：两个论坛通用，登录/浏览时自动保存登录态（forum-signin.js 的 http-request 身份）
cookie-capture = type=http-request, pattern=^https?://(www\.)?(583go\.com|clxp\.net\.cn)/, script-path=https://github.com/miloveu/loon_plugin/blob/main/forum-signin.js, requires-body=false, timeout=10, enabled=true

# 每日定时登录（每天 09:20 执行，可自行修改 cron 表达式）（forum-signin.js 的 cron 身份）
daily-checkin = type=cron, cron="20 9 * * *", script-path=https://github.com/miloveu/loon_plugin/blob/main/forum-signin.js, timeout=120, enabled=true

# MITM：clxp 为 HTTPS，读取其请求头 Cookie 需要解密；583go 为 HTTP 不受影响
# 若未安装 Loon 根证书，请到 Loon → 配置 → 证书 安装并信任
[MITM]
hostname = www.clxp.net.cn
