#!name = 论坛每日登录领积分（网吧三国 + 死性不改BBS）
#!desc = Safari 登录论坛时自动抓取 Cookie；每天定时用 Cookie 登录论坛、领取每日任务（天天打卡）奖励并通知。Cookie 失效会提醒重新登录。一份脚本双入口：http-request 抓 Cookie，cron 每日签到。
#!author = WorkBuddy

# Loon 官方脚本语法：http-request <URL正则> script-path=...,tag=...,enable=true
# 地址带 ?v=N 版本参数，用于强制 Loon 刷新脚本缓存（每次更新脚本时递增 N）
[Script]
http-request ^https?:\/\/(www\.)?583go\.com script-path=https://raw.githubusercontent.com/miloveu/loon_plugin/main/forum-signin.js?v=3,tag=583go-Cookie,requires-body=false,timeout=10,enable=true
http-request ^https?:\/\/(www\.)?clxp\.net\.cn script-path=https://raw.githubusercontent.com/miloveu/loon_plugin/main/forum-signin.js?v=3,tag=clxp-Cookie,requires-body=false,timeout=10,enable=true
cron "20 9 * * *" script-path=https://raw.githubusercontent.com/miloveu/loon_plugin/main/forum-signin.js?v=3,tag=每日登录领积分,timeout=120,enable=true

# 手动运行入口：出现在 Loon 首页「脚本任务」里，可随时点 ▶ 执行一次签到
generic script-path=https://raw.githubusercontent.com/miloveu/loon_plugin/main/forum-signin.js?v=3,tag=手动签到测试,timeout=120,enable=true

# 分流：两个论坛都是国内站，强制直连，避免走代理节点打不开
[Rule]
DOMAIN-SUFFIX,583go.com,DIRECT
DOMAIN-SUFFIX,clxp.net.cn,DIRECT

# MITM：两个站都要解密（Safari 会把 583go 的 http 自动升级为 https）
# 前提：Loon → 配置 → 证书 已生成并安装，且 iOS 设置里已完全信任该证书
[MITM]
hostname = www.583go.com, www.clxp.net.cn, 583go.com, clxp.net.cn
